{
  "name": "@anim8/renderer-sketch",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "import": "./dist/live.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "dependencies": {
    "@anim8/core": "workspace:*",
    "@anim8/sketch": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts src/live.ts --format esm --dts --clean --splitting",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "description": "Deterministic hand-drawn SVG renderer for Anim8 scenes, with a bundled OFL hand-drawn font.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkcbuilds/anim8.git",
    "directory": "packages/renderer-sketch"
  },
  "homepage": "https://github.com/nkcbuilds/anim8#readme",
  "bugs": {
    "url": "https://github.com/nkcbuilds/anim8/issues"
  }
}
