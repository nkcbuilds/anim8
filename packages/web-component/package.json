{
  "name": "@anim8/web-component",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@anim8/core": "workspace:*",
    "@anim8/player": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "description": "Accessible framework-independent web component for Anim8 playback.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkcbuilds/anim8.git",
    "directory": "packages/web-component"
  },
  "homepage": "https://github.com/nkcbuilds/anim8#readme",
  "bugs": {
    "url": "https://github.com/nkcbuilds/anim8/issues"
  }
}
