{
  "name": "@anim8/react",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@anim8/player": "workspace:*",
    "@anim8/renderer-svg": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "description": "SSR-safe React integration for Anim8.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkcbuilds/anim8.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/nkcbuilds/anim8#readme",
  "bugs": {
    "url": "https://github.com/nkcbuilds/anim8/issues"
  }
}
