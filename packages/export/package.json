{
  "name": "@anim8/export",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "anim8-export": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@anim8/core": "workspace:*",
    "@anim8/compiler": "workspace:*",
    "@anim8/renderer-svg": "workspace:*"
  },
  "peerDependencies": {
    "playwright": "^1.50.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && tsup src/cli.ts --format esm --no-splitting",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "description": "Optional deterministic scene frames, PNG/GIF/MP4 export with explicit Playwright and FFmpeg dependencies.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkcbuilds/anim8.git",
    "directory": "packages/export"
  },
  "homepage": "https://github.com/nkcbuilds/anim8#readme",
  "bugs": {
    "url": "https://github.com/nkcbuilds/anim8/issues"
  }
}
