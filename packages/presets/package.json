{
  "name": "@anim8/presets",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@anim8/authoring": "workspace:*",
    "@anim8/core": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "description": "Higher-level technical diagram primitives composed from Anim8 generic scene objects.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkcbuilds/anim8.git",
    "directory": "packages/presets"
  },
  "homepage": "https://github.com/nkcbuilds/anim8#readme",
  "bugs": {
    "url": "https://github.com/nkcbuilds/anim8/issues"
  }
}
