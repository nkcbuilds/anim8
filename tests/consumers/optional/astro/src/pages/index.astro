---
import { renderSceneAt } from "@anim8/renderer-svg";
import { scene } from "../scene.js";

const staticSvg = renderSceneAt(scene, 0);
---

<html lang="en">
  <head>
    <title>Anim8 Astro consumer fixture</title>
  </head>
  <body>
    <h1>Anim8 Astro consumer fixture</h1>
    <div
      id="anim8-astro-fixture"
      aria-label="Anim8 Astro fixture animation"
      set:html={staticSvg}
    ></div>

    <script>
      import { mountPlayer } from "@anim8/player";
      import { scene } from "../scene.js";

      const target = document.querySelector("#anim8-astro-fixture");
      if (target) {
        const controller = mountPlayer(target, scene);
        globalThis.__anim8AstroController = controller;
      }
    </script>
  </body>
</html>
