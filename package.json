{
  "name": "anim8-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "packaging": "node tests/packaging/check.mjs",
    "consumers": "node tests/consumers/run.mjs",
    "benchmark": "node benchmarks/run-baseline.mjs",
    "browser": "node tests/browser/run.mjs",
    "catalog:generate": "node examples/catalog/generate.mjs",
    "catalog:check": "node examples/catalog/generate.mjs --check",
    "catalog": "node tests/catalog/run.mjs",
    "catalog:browser": "node tests/catalog/browser.mjs",
    "catalog:serve": "node examples/catalog/serve.mjs",
    "playground": "node examples/playground/server.mjs",
    "playground:browser": "node tests/qualification/playground.mjs",
    "qualification:browser": "node tests/qualification/browser.mjs",
    "security:adversarial": "node tests/qualification/adversarial.mjs",
    "model:providers:smoke": "node tests/model-eval/test.mjs",
    "model:benchmark": "node tests/model-eval/run.mjs",
    "release:preflight": "node tests/release/preflight.mjs",
    "release:metadata": "node tests/release/check-version.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm packaging && pnpm consumers && pnpm catalog:check && pnpm catalog && pnpm security:adversarial && pnpm model:providers:smoke && pnpm release:metadata && pnpm release:preflight",
    "release:check": "pnpm check && pnpm browser && pnpm catalog:browser && pnpm playground:browser && pnpm qualification:browser"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.10.0",
    "astro": "^7.4.2",
    "esbuild": "^0.28.2",
    "next": "^16.4.3",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
